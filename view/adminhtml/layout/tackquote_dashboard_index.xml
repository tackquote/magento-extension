<?xml version="1.0"?>
<!--
  TackQuote admin dashboard layout.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="admin-1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="TackQuote_Quotes::css/dashboard.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="TackQuote\Quotes\Block\Adminhtml\Dashboard"
                   name="tackquote.dashboard"
                   template="TackQuote_Quotes::dashboard.phtml">
                <!-- Connect with TackQuote: connection state, Connect / Disconnect. -->
                <block class="TackQuote\Quotes\Block\Adminhtml\ConnectCard"
                       name="tackquote.connect.card"
                       as="connect_card"/>
            </block>
        </referenceContainer>
    </body>
</page>
