        <div class="tq-overview-panel" id="tq-panel-forms">
            <section class="admin__page-section">
                <?= /* @noEscape */ $title('tq-forms-title', (string) __('Forms'), $forms) ?>
                <?= /* @noEscape */ $table($forms, 'tq-forms-title') ?>
            </section>
        </div>

        <div class="tq-overview-panel" id="tq-panel-orders">
            <section class="admin__page-section">
                <?= /* @noEscape */ $title('tq-orders-title', (string) __('Orders'), $orders) ?>
                <?= /* @noEscape */ $table($orders, 'tq-orders-title') ?>
                <p class="tq-overview-note">
