    </p>

    <div class="tq-overview-tabs" data-mage-init="<?= $escaper->escapeHtmlAttr(json_encode($tabsInit)) ?>">
        <ul class="tabs-horiz">
            <?php foreach ($overview->getTabs() as $panel => $label): ?>
                <li>
                    <a href="#<?= $escaper->escapeHtmlAttr($panel) ?>"
                       id="<?= $escaper->escapeHtmlAttr(str_replace('tq-panel-', 'tq-tab-', $panel)) ?>"
                       class="tab-item-link">
                        <span><?= $escaper->escapeHtml($label) ?></span>
                    </a>
                </li>
            <?php endforeach; ?>
        </ul>

        <div class="tq-overview-panel" id="tq-panel-connection">
            <section class="admin__page-section">
                <?= /* @noEscape */ $title('tq-connection-title', (string) __('Connection')) ?>
                <div class="admin__page-section-content tq-overview-columns">
                    <?= $block->getChildHtml('connect_card') ?>
                    <div class="admin__page-section-item">
                        <h3 class="admin__page-section-item-title" id="tq-details-title">
                            <span class="title"><?= $escaper->escapeHtml(__('Connection details')) ?></span>
