                                </tr>
                                <tr>
                                    <th scope="row"><?= $escaper->escapeHtml(__('API key')) ?></th>
                                    <td>
                                        <span class="tq-overview-state <?= $overview->hasApiKey()
                                            ? 'grid-severity-notice'
                                            : 'grid-severity-minor' ?>">
                                            <span><?= $escaper->escapeHtml($overview->hasApiKey() ? __(
                                                'Set'
                                            ) : __('Not set')) ?></span>
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row"><?= $escaper->escapeHtml(__('Button label')) ?></th>
                                    <td class="tq-overview-value"><?= $escaper->escapeHtml(
                                        $overview->getButtonLabel()
                                    ) ?></td>
                                </tr>
                                </tbody>
                            </table>
                            <?php if ($canConfigure): ?>
                                <p class="tq-overview-links">
                                    <?php $url = $overview->getGroupUrl('general'); ?>
                                    <?php $label = __('Connection settings'); ?>
                                    <a href="<?= $escaper->escapeUrl($url) ?>"><?= $escaper->escapeHtml($label) ?></a>
                                </p>
                            <?php endif; ?>
                        </div>
                    </div>
                </div>
            </section>

            <section class="admin__page-section">
                <?= /* @noEscape */ $title('tq-setup-title', (string) __('Setup')) ?>
                <table class="admin__table-secondary tq-overview-table" aria-labelledby="tq-setup-title">
                    <thead>
                    <tr>
                        <th scope="col" class="tq-overview-col-setting"><?= $escaper->escapeHtml(__('Step')) ?></th>
                        <th scope="col" class="tq-overview-col-state"><?= $escaper->escapeHtml(__('State')) ?></th>
                        <th scope="col"><?= $escaper->escapeHtml(__('What to do')) ?></th>
                    </tr>
                    </thead>
                    <tbody>
                    <?php foreach ($checklist as $item): ?>
                        <tr>
                            <th scope="row"><?= $escaper->escapeHtml($item['label']) ?></th>
                            <td class="tq-overview-col-state">
                                <span class="tq-overview-state <?= $item['ok']
