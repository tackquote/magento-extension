                        <td class="tq-overview-value"><?= $escaper->escapeHtml($overview->getModuleVersion()) ?></td>
                    </tr>
                    <tr>
                        <th scope="row"><?= $escaper->escapeHtml(__('Setup guide')) ?></th>
                        <td class="tq-overview-value">
                            <a href="<?= $escaper->escapeUrl($overview::DOCS_URL) ?>"
                               target="_blank" rel="noopener noreferrer">
                                <?= $escaper->escapeHtml($overview::DOCS_URL) ?>
