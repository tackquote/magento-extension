/**
 * An On/Off pill.
 *
 * @param bool $on
 * @return string
 */
$pill = static function (bool $on) use ($escaper): string {
    return $on
        ? '<span class="tq-pill tq-pill--ok">' . $escaper->escapeHtml(__('On')) . '</span>'
        : '<span class="tq-pill tq-pill--off">' . $escaper->escapeHtml(__('Off')) . '</span>';
};

/**
 * A card heading with an "N of M on" count.
 *
 * @param string $id
 * @param string $title
 * @param array $rows
 * @return string
 */
$head = static function (string $id, string $title, array $rows) use ($block, $escaper): string {
    $on = $block->countOn($rows);
    return '<div class="tq-card__head"><h2 class="tq-card__title" id="' . $escaper->escapeHtmlAttr($id . '-title') . '">'
        . $escaper->escapeHtml($title) . '</h2><span class="tq-pill tq-pill--' . ($on > 0 ? 'ok' : 'off') . '">'
        . $escaper->escapeHtml(__('%1 of %2 on', $on, count($rows))) . '</span></div>';
};

/**
 * Rows of On/Off switches.
 *
 * @param array $rows
 * @return string
 */
$switches = static function (array $rows) use ($escaper, $pill): string {
    $html = '<dl class="tq-facts">';
    foreach ($rows as $row) {
        $html .= '<dt>' . $escaper->escapeHtml($row['label']) . '</dt><dd>' . $pill((bool) $row['on']) . '</dd>';
    }
    return $html . '</dl>';
};

/**
 * "Configure" links to configuration groups: group id => link text.
 *
 * @param array $links
 * @return string
 */
$foot = static function (array $links) use ($block, $escaper, $canConfigure): string {
    if (!$canConfigure || $links === []) {
        return '';
    }
    $html = '<div class="tq-card__foot">';
    foreach ($links as $group => $label) {
        $html .= '<a class="tq-link" href="' . $escaper->escapeUrl($block->getGroupUrl($group)) . '">'
            . $escaper->escapeHtml($label) . '</a>';
    }
    return $html . '</div>';
};
