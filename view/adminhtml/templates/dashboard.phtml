<?php
/**
 * TackQuote admin Overview (TackQuote > Overview), built from Magento admin components.
 *
 * - Status: standard admin messages (message-success / message-warning), plus the
 *   #tq-test-result message that "Test connection" (overview/actions.phtml) fills in.
 * - Tabs: one horizontal tab per settings area, in the WooCommerce plugin's tab order, using
 *   mage/backend/tabs on a ul.tabs-horiz, the widget and markup of the core Dashboard's tabs
 *   (Magento_Backend view/adminhtml/templates/widget/tabshoriz.phtml). The widget sets the
 *   tablist/tab/tabpanel roles and the keyboard handling; only one area shows at a time.
 * - Inside each tab: admin__page-section blocks, and the switches as an admin__table-secondary
 *   table (setting | state | settings link). Each link opens its configuration group, expanded
 *   (ViewModel\Adminhtml\Overview::getGroupUrl()); links are left out for an admin without the
 *   configuration permission.
 *
 * No inline script and no inline style: behaviour is loaded through data-mage-init, and the
 * accent swatch is painted by TackQuote_Quotes/js/swatch from a validated hex value.
 *
 * @var \Magento\Backend\Block\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @package TackQuote_Quotes
 */

/** @var \TackQuote\Quotes\ViewModel\Adminhtml\Overview $overview */
$overview = $block->getData('overview');
/** @var \TackQuote\Quotes\ViewModel\Adminhtml\CronStatus $cron */
$cron = $block->getData('cron_status');

$checklist = $overview->getChecklist();
$allOk = true;
foreach ($checklist as $item) {
    $allOk = $allOk && $item['ok'];
}
$cronRan = $cron->hasRun();
// The cron job reports success even when TackQuote did not answer; say so on the same row.
$pingFailure = $cron->getLastPingFailure();
$pingNote = $pingFailure !== null
    ? (string) __(
        'Last server check failed at %1: %2',
        $block->formatDate($pingFailure['at'], \IntlDateFormatter::MEDIUM, true),
        $pingFailure['reason']
    )
    : '';
$checklist[] = [
    'label' => (string) __('Magento cron has run'),
    'ok' => $cronRan,
    'hint' => trim((string) __(
        'Set up Magento cron (bin/magento cron:install), then check again in 5 minutes.'
    ) . ' ' . $pingNote),
    'note' => implode('. ', array_filter([
        $cronRan
            ? (string) __('Last run: %1', $block->formatDate($cron->getLastRunAt(), \IntlDateFormatter::MEDIUM, true))
            : '',
        $pingNote,
    ])),
];
$canConfigure = $overview->canConfigure();
// Beside a switched-on feature that needs the server's capability list while it is unknown
// or failing ("Waiting for the first server check."), instead of the feature silently missing.
$serverNote = $cron->getServerCheckNote();

/**
 * A state badge that never wraps: the admin's grid-severity badges, or a neutral one for Off.
 *
 * @param bool $on
 * @return string
 */
$state = function (bool $on) use ($escaper): string {
    return '<span class="tq-overview-state ' . ($on ? 'grid-severity-notice' : 'tq-overview-state--off') . '"><span>'
        . $escaper->escapeHtml($on ? __('On') : __('Off')) . '</span></span>';
};

/**
 * A section title with an optional "N of M on" count.
 *
 * @param string $id
 * @param string $title
 * @param array|null $rows
 * @return string
 */
$title = function (string $id, string $title, ?array $rows = null) use ($overview, $escaper): string {
    $html = '<h2 class="admin__page-section-title" id="' . $escaper->escapeHtmlAttr($id) . '"><span class="title">'
        . $escaper->escapeHtml($title) . '</span>';
    if ($rows !== null) {
        $html .= '<span class="tq-overview-count">' . $escaper->escapeHtml(
            __('%1 of %2 on', $overview->countOn($rows), $overview->countSwitches($rows))
        ) . '</span>';
    }

    return $html . '</h2>';
};

/**
 * A setting | state | link table. A row with `on` === null shows its `value` instead of a badge.
 *
 * @param array $rows
 * @param string $labelledBy
 * @return string
 */
$table = function (array $rows, string $labelledBy) use (
    $overview,
    $escaper,
    $state,
    $canConfigure,
    $serverNote
): string {
    $html = '<table class="admin__table-secondary tq-overview-table" aria-labelledby="'
        . $escaper->escapeHtmlAttr($labelledBy) . '"><thead><tr>'
        . '<th scope="col" class="tq-overview-col-setting">' . $escaper->escapeHtml(__('Setting')) . '</th>'
        . '<th scope="col" class="tq-overview-col-state">' . $escaper->escapeHtml(__('State')) . '</th>'
        . '<th scope="col" class="tq-overview-col-action"><span class="tq-overview-sr">'
        . $escaper->escapeHtml(__('Settings')) . '</span></th></tr></thead><tbody>';
    foreach ($rows as $row) {
        $html .= '<tr><th scope="row">' . $escaper->escapeHtml($row['label']);
        if (!empty($row['server']) && $row['on'] === true && $serverNote !== '') {
            $html .= '<span class="tq-overview-row-note">' . $escaper->escapeHtml($serverNote) . '</span>';
        }
        $html .= '</th>';
        if ($row['on'] === null) {
            $swatch = '';
            if (($row['swatch'] ?? '') !== '' && $overview->isSwatch($row['swatch'])) {
                $swatch = '<span class="tq-overview-swatch" aria-hidden="true" data-mage-init="'
                    . $escaper->escapeHtmlAttr(
                        json_encode(['TackQuote_Quotes/js/swatch' => ['color' => $row['swatch']]])
                    )
                    . '"></span>';
            }
            $html .= '<td class="tq-overview-value">' . $swatch . $escaper->escapeHtml($row['value'] ?? '') . '</td>';
        } else {
            $html .= '<td class="tq-overview-col-state">' . $state((bool) $row['on']) . '</td>';
        }
        $html .= '<td class="tq-overview-col-action">';
        if ($canConfigure && ($row['group'] ?? '') !== '') {
            $html .= '<a href="' . $escaper->escapeUrl($overview->getGroupUrl($row['group'])) . '">'
                . $escaper->escapeHtml(__('Configure'))
                . '<span class="tq-overview-sr"> ' . $escaper->escapeHtml($row['label']) . '</span></a>';
        }
        $html .= '</td></tr>';
    }

    return $html . '</tbody></table>';
};

$storefront = $overview->getStorefrontRows();
$quoteOnly = $overview->getQuoteOnlyRows();
$pricing = $overview->getB2bSwitches();
$groups = $overview->getGroupRuleRows();
$forms = $overview->getFormsRows();
$orders = $overview->getOrdersRows();
$tabsInit = ['mage/backend/tabs' => ['active' => 'tq-tab-connection']];
?>
<div class="tq-overview">
    <div class="messages">
        <div class="message <?= $allOk ? 'message-success success' : 'message-warning warning' ?>" role="status">
            <div>
                <?= $escaper->escapeHtml(
                    $allOk
                        ? __('Ready: the quote button is live on your product pages.')
                        : __('Not live yet. Finish the setup steps on the Connection tab to show the quote button.')
                ) ?>
            </div>
        </div>
        <?php if (!$cronRan): ?>
            <div class="message message-warning warning">
                <div>
                    <?= $escaper->escapeHtml(__(
                        'Magento cron has not run TackQuote\'s jobs yet. The storefront asks TackQuote itself '
                        . 'when nothing is cached, but without cron your registration settings and the server\'s '
                        . 'capabilities are not kept fresh.'
                    )) ?>
                </div>
            </div>
        <?php endif; ?>
        <div class="message" id="tq-test-result" role="status" aria-live="polite" hidden>
            <div data-role="text"></div>
        </div>
    </div>

    <p class="tq-overview-scope">
        <?= $escaper->escapeHtml(__(
            'These are the Default Config settings. A website can override any of them: choose it in the scope '
