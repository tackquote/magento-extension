<?xml version="1.0"?>
<!-- My Account > Net terms. Per-customer content: not cacheable. -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceContainer name="content">
            <block class="TackQuote\Quotes\Block\Account\NetTermsForm"
                   name="tackquote.account.netterms"
                   template="TackQuote_Quotes::account/net-terms.phtml"
                   cacheable="false"/>
        </referenceContainer>
    </body>
</page>
