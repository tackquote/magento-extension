<?xml version="1.0"?>
<!--
  Registers the "Pay on net terms" renderer with the checkout's payment step (lane
  MG-FORMS-TERMS), the documented path for a payment method's frontend component:
  checkout.root > ... > billing-step > payment > renders. Whether the method appears at all is
  decided per quote on the server (Model\Payment\NetTermsMethod::isAvailable()).
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.root">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="checkout" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="steps" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="billing-step" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="payment" xsi:type="array">
                                                    <item name="children" xsi:type="array">
                                                        <item name="renders" xsi:type="array">
                                                            <item name="children" xsi:type="array">
                                                                <item name="tackquote-net-terms" xsi:type="array">
                                                                    <item name="component" xsi:type="string">TackQuote_Quotes/js/view/payment/net-terms</item>
                                                                    <item name="methods" xsi:type="array">
                                                                        <item name="tackquote_net_terms" xsi:type="array">
                                                                            <item name="isBillingAddressRequired" xsi:type="boolean">true</item>
                                                                        </item>
                                                                    </item>
                                                                </item>
                                                            </item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
