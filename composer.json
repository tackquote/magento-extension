{
  "name": "tackquote/module-quotes",
  "description": "TackQuote for Magento 2 — \"Request a Quote\" and multi-product \"Add to Quote\" storefront controls that create real TackQuote B2B quote requests. Companion to the TackQuote WooCommerce plugin.",
  "type": "magento2-module",
  "license": "GPL-2.0-or-later",
  "version": "1.5.2",
  "require": {
    "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
    "magento/framework": "103.0.*",
    "magento/module-authorization": "100.4.*",
    "magento/module-backend": "102.0.*",
    "magento/module-catalog": "104.0.*",
    "magento/module-catalog-search": "102.0.*",
    "magento/module-checkout": "100.4.*",
    "magento/module-config": "101.2.*",
    "magento/module-configurable-product": "100.4.*",
    "magento/module-cron": "100.4.*",
    "magento/module-customer": "103.0.*",
    "magento/module-eav": "102.1.*",
    "magento/module-payment": "100.4.*",
    "magento/module-quote": "101.2.*",
    "magento/module-shipping": "100.4.*",
    "magento/module-sales": "103.0.*",
    "magento/module-store": "101.1.*",
    "magento/module-tax": "100.4.*",
    "magento/module-theme": "101.1.*",
    "magento/module-ui": "101.2.*"
  },
  "require-dev": {
    "magento/magento-coding-standard": "^40",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "files": ["registration.php"],
    "psr-4": {
      "TackQuote\\Quotes\\Block\\": "Block/",
      "TackQuote\\Quotes\\Controller\\": "Controller/",
      "TackQuote\\Quotes\\Cron\\": "Cron/",
      "TackQuote\\Quotes\\Model\\": "Model/",
      "TackQuote\\Quotes\\Observer\\": "Observer/",
      "TackQuote\\Quotes\\Plugin\\": "Plugin/",
      "TackQuote\\Quotes\\Setup\\": "Setup/",
      "TackQuote\\Quotes\\ViewModel\\": "ViewModel/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TackQuote\\Quotes\\Test\\": "Test/"
    }
  },
  "scripts": {
    "lint": "phpcs --severity=1",
    "standards": "bash scripts/check-standards.sh vendor/bin/phpcs",
    "test": "phpunit --configuration Test/Unit/phpunit.xml"
  }
}
