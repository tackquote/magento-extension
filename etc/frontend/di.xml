<?xml version="1.0"?>
<!--
  Quote-only (B2B catalog) mode wiring.

  THE PATH OF THIS FILE IS PART OF THE FEATURE. Everything declared here is generated as an
  interceptor for the FRONTEND AREA ONLY. That is what keeps the admin exempt: Magento's
  admin order creation (Sales > Orders > Create New Order) drives the very same
  Magento\Quote\Model\Quote::addProduct() that the storefront does, and refusing it would
  stop a merchant taking a phone order and stop TackQuote converting an accepted quote into
  a real order.

  Area-scoped di.xml is Magento's own mechanism for exactly this, not a local invention —
  core scopes Magento\Customer\Model\App\Action\ContextPlugin the same way in
  vendor/magento/module-customer/etc/frontend/di.xml:23-26. Moving any of these <type>
  blocks into etc/di.xml would make the module refuse the merchant's own admin orders.
  There is no runtime area check to compensate, and there deliberately is not one: a check
  can be edited out or got wrong, a file that adminhtml never loads cannot be.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
      WHO IS ASKING, on the storefront: the customer session. Other areas bind the same
      interface to the Web API user context (etc/webapi_rest, etc/webapi_soap, etc/graphql)
      or to an always-exempt visitor (global etc/di.xml).

      The session is injected as a Proxy so that merely CONSTRUCTING the visitor never
      starts a customer session. QuoteOnlyMode::isActive() runs the cheap store-config checks
      first and only touches the session once the mode might actually apply.
    -->
    <preference for="TackQuote\Quotes\Model\QuoteOnly\VisitorContextInterface"
                type="TackQuote\Quotes\Model\QuoteOnly\SessionVisitorContext"/>
    <type name="TackQuote\Quotes\Model\QuoteOnly\SessionVisitorContext">
        <arguments>
            <argument name="customerSession" xsi:type="object">Magento\Customer\Model\Session\Proxy</argument>
        </arguments>
    </type>

    <!--
      THE REFUSAL. Magento\Quote\Model\Quote::addProduct() is `@api` (Quote.php:34) and is
      the single model every add path funnels through — the product page, related products,
      wishlist "Add to Cart", addgroup, and Magento\Checkout\Model\Cart::addProduct(), which
      is itself just a caller (module-checkout/Model/Cart.php:392).
    -->
    <type name="Magento\Quote\Model\Quote">
        <plugin name="tackquote_quote_only_cart_guard"
                type="TackQuote\Quotes\Plugin\Quote\QuoteOnlyCartGuard"
                sortOrder="10"/>
    </type>

    <!-- Mutations of a cart that already existed when the mode was switched on. -->
    <type name="Magento\Checkout\Model\Cart">
        <plugin name="tackquote_quote_only_existing_cart_guard"
                type="TackQuote\Quotes\Plugin\Checkout\QuoteOnlyExistingCartGuard"
                sortOrder="10"/>
    </type>

    <!-- The checkout route itself. -->
    <type name="Magento\Checkout\Controller\Index\Index">
        <plugin name="tackquote_quote_only_checkout_guard"
                type="TackQuote\Quotes\Plugin\Checkout\QuoteOnlyCheckoutGuard"
                sortOrder="10"/>
    </type>
    <type name="TackQuote\Quotes\Plugin\Checkout\QuoteOnlyCheckoutGuard">
        <arguments>
            <argument name="checkoutSession" xsi:type="object">Magento\Checkout\Model\Session\Proxy</argument>
        </arguments>
    </type>
    <type name="TackQuote\Quotes\Observer\QuoteOnlyMultishippingGuard">
        <arguments>
            <argument name="checkoutSession" xsi:type="object">Magento\Checkout\Model\Session\Proxy</argument>
        </arguments>
    </type>

    <!--
      ORDER PLACEMENT from the storefront area (payment flows such as PayPal Express review
      that place the order without the checkout page). The same plugin is declared for the
      Web API and GraphQL areas, where Luma's checkout and GraphQL's placeOrder run.
    -->
    <type name="Magento\Quote\Model\QuoteManagement">
        <plugin name="tackquote_quote_only_submit_guard"
                type="TackQuote\Quotes\Plugin\Quote\QuoteOnlySubmitGuard"
                sortOrder="10"/>
    </type>

    <!-- "Price on request" and the per-product "Available on quote" label. -->
    <type name="Magento\Framework\Pricing\Render">
        <plugin name="tackquote_quote_only_price_render"
                type="TackQuote\Quotes\Plugin\Pricing\QuoteOnlyPriceRender"
                sortOrder="10"/>
    </type>

    <!--
      Page-cache vary value for the "except approved wholesale accounts" scope. Adobe's
      documented way to vary public content: a beforeGetVaryString plugin on the HTTP context.
    -->
    <type name="Magento\Framework\App\Http\Context">
        <plugin name="tackquote_wholesale_approval_context"
                type="TackQuote\Quotes\Plugin\PageCache\WholesaleApprovalContext"
                sortOrder="10"/>
    </type>
    <!--
      The vary string is computed on every storefront response, so the plugin gets the mode
      through a Proxy: nothing behind it (product resource, API client) is built unless the
      store actually uses the "except approved wholesale accounts" scope.
    -->
    <type name="TackQuote\Quotes\Plugin\PageCache\WholesaleApprovalContext">
        <arguments>
            <argument name="quoteOnlyMode" xsi:type="object">TackQuote\Quotes\Model\QuoteOnlyMode\Proxy</argument>
        </arguments>
    </type>

    <!--
      B2B CHECKOUT ENFORCEMENT (Stores > Configuration > TackQuote > B2B Checkout). New <type>
      blocks only; Magento merges them with the quote-only declarations above, and every plugin
      below is ordered AFTER the quote-only guard on the same method (sortOrder 20/30 > 10), so a
      cart quote-only mode refuses is never priced or limit-checked. Area-scoped for the same
      reason as everything else in this file: the admin order editor must keep its own prices.

      The account price is put on the cart lines before every totals collection, and the order
      limit is checked whenever a line is added.
    -->
    <type name="Magento\Quote\Model\Quote">
        <plugin name="tackquote_account_price_totals"
                type="TackQuote\Quotes\Plugin\Quote\AccountPriceTotalsPlugin"
                sortOrder="20"/>
        <plugin name="tackquote_order_limit_cart_guard"
                type="TackQuote\Quotes\Plugin\Quote\OrderLimitCartGuard"
                sortOrder="20"/>
    </type>

    <!-- Cart page "Update Shopping Cart" and the mini cart's quantity update. -->
    <type name="Magento\Checkout\Model\Cart">
        <plugin name="tackquote_order_limit_update_items_guard"
                type="TackQuote\Quotes\Plugin\Checkout\OrderLimitUpdateItemsGuard"
                sortOrder="20"/>
    </type>

    <!--
      At order submit: re-resolve the account prices with a fresh TackQuote answer (20), then
      check every order limit against the total that will be charged (30).
    -->
    <type name="Magento\Quote\Model\QuoteManagement">
        <plugin name="tackquote_account_price_submit"
                type="TackQuote\Quotes\Plugin\Quote\AccountPriceSubmitPlugin"
                sortOrder="20"/>
        <plugin name="tackquote_order_limit_submit_guard"
                type="TackQuote\Quotes\Plugin\Quote\OrderLimitSubmitGuard"
                sortOrder="30"/>
    </type>
</config>
