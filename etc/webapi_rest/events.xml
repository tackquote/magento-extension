<?xml version="1.0"?>
<!--
  Buyer-group rules in the webapi_rest area: the same storefront checks as etc/frontend/events.xml
  for REST callers. Admin and integration tokens are exempt (Model\Groups\Audience through
  Model\QuoteOnly\ApiVisitorContext), which keeps TackQuote's own quote conversion unaffected.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!--
      Buyer-group rules (Model\Groups\*). Payment methods by buyer group: refused at listing
      AND at "set payment method" time, since both ask isAvailable(), which dispatches this
      event (Observer\PaymentMethodGroupRestriction).
    -->
    <event name="payment_method_is_active">
        <observer name="tackquote_payment_method_group_restriction"
                  instance="TackQuote\Quotes\Observer\PaymentMethodGroupRestriction"/>
    </event>
    <!-- Hidden categories: their products cannot be added to a cart (Quote::addProduct checks salability). -->
    <event name="catalog_product_is_salable_after">
        <observer name="tackquote_hidden_product_not_salable"
                  instance="TackQuote\Quotes\Observer\HiddenProductNotSalable"/>
    </event>
</config>
