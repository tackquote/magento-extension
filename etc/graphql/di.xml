<?xml version="1.0"?>
<!--
  Quote-only (B2B catalog) mode in the graphql area.

  Storefront callers of the GraphQL API — a customer token, a customer session, or nobody at
  all — get the same refusals as the storefront. The merchant's admin and integration tokens
  do not: Model\QuoteOnly\ApiVisitorContext types the caller through
  Magento\Authorization\Model\UserContextInterface and marks USER_TYPE_ADMIN and
  USER_TYPE_INTEGRATION as exempt. That is what keeps TackQuote's own quote conversion
  working: it calls the store's guest-cart REST endpoints signed with the Integration's
  OAuth credentials, which Magento types as an integration.

  Area-scoped di.xml: developer.adobe.com/commerce/php/development/build/dependency-injection-file
  ("Areas and application entry points"). The admin area loads none of these files.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <preference for="TackQuote\Quotes\Model\QuoteOnly\VisitorContextInterface"
                type="TackQuote\Quotes\Model\QuoteOnly\ApiVisitorContext"/>

    <!-- Every new cart line: CartItemPersister / AddProductsToCart call Quote::addProduct(). -->
    <type name="Magento\Quote\Model\Quote">
        <!-- Accepted quote checkout link (lane MG-QUOTE-CHECKOUT-LINK): FIRST (5) on this method,
             see the header of Plugin\Quote\QuoteCheckoutCartGuard. -->
        <plugin name="tackquote_quote_checkout_cart_guard"
                type="TackQuote\Quotes\Plugin\Quote\QuoteCheckoutCartGuard"
                sortOrder="5"/>
        <plugin name="tackquote_quote_only_cart_guard"
                type="TackQuote\Quotes\Plugin\Quote\QuoteOnlyCartGuard"
                sortOrder="10"/>
        <plugin name="tackquote_account_price_totals"
                type="TackQuote\Quotes\Plugin\Quote\AccountPriceTotalsPlugin"
                sortOrder="20"/>
        <plugin name="tackquote_order_limit_cart_guard"
                type="TackQuote\Quotes\Plugin\Quote\OrderLimitCartGuard"
                sortOrder="20"/>
        <!-- Buyer-group rules: tax-exempt buyers (Plugin\Tax\TaxExemptCustomerClass). -->
        <plugin name="tackquote_tax_exempt_customer_class"
                type="TackQuote\Quotes\Plugin\Tax\TaxExemptCustomerClass"
                sortOrder="40"/>
    </type>

    <!-- Quantity increases on an existing line, which never reach addProduct(). -->
    <type name="Magento\Quote\Api\CartItemRepositoryInterface">
        <!-- Accepted quote checkout link (lane MG-QUOTE-CHECKOUT-LINK): FIRST (5) on this method,
             see the header of Plugin\Quote\QuoteCheckoutCartItemRepositoryLock. -->
        <plugin name="tackquote_quote_checkout_cart_item_repository_lock"
                type="TackQuote\Quotes\Plugin\Quote\QuoteCheckoutCartItemRepositoryLock"
                sortOrder="5"/>
        <plugin name="tackquote_quote_only_cart_item_repository_guard"
                type="TackQuote\Quotes\Plugin\Quote\QuoteOnlyCartItemRepositoryGuard"
                sortOrder="10"/>
        <plugin name="tackquote_order_limit_cart_item_repository_guard"
                type="TackQuote\Quotes\Plugin\Quote\OrderLimitCartItemRepositoryGuard"
                sortOrder="20"/>
    </type>

    <!-- Order placement: placeOrder / payment-information end in QuoteManagement::submit(). -->
    <type name="Magento\Quote\Model\QuoteManagement">
        <!-- Accepted quote checkout link (lane MG-QUOTE-CHECKOUT-LINK): FIRST (5) on this method,
             see the header of Plugin\Quote\QuoteCheckoutSubmitGuard. -->
        <plugin name="tackquote_quote_checkout_submit_guard"
                type="TackQuote\Quotes\Plugin\Quote\QuoteCheckoutSubmitGuard"
                sortOrder="5"/>
        <plugin name="tackquote_quote_only_submit_guard"
                type="TackQuote\Quotes\Plugin\Quote\QuoteOnlySubmitGuard"
                sortOrder="10"/>
        <plugin name="tackquote_account_price_submit"
                type="TackQuote\Quotes\Plugin\Quote\AccountPriceSubmitPlugin"
                sortOrder="20"/>
        <plugin name="tackquote_order_limit_submit_guard"
                type="TackQuote\Quotes\Plugin\Quote\OrderLimitSubmitGuard"
                sortOrder="30"/>
    </type>

    <!--
      B2B CHECKOUT ENFORCEMENT (Stores > Configuration > TackQuote > B2B Checkout). Its plugins
      sit in the quote-only <type> blocks above (one block per class: Magento's di.xsd has a
      `uniqueType` constraint, and a second block for the same class fails validation in
      developer mode), and every plugin is ordered AFTER the quote-only guard on the same method
      (sortOrder 20/30 > 10), so a
      cart quote-only mode refuses is never priced or limit-checked. Area-scoped for the same
      reason as everything else in this file: the admin order editor must keep its own prices.

      The account price is put on the cart lines before every totals collection, and the order
      limit is checked whenever a line is added.
    -->
    <!-- (merged into the first <type> block for this class above: one block per class, as
         Magento's di.xsd `uniqueType` constraint requires) -->

    <!-- Quantity changes on an existing line, which never reach addProduct(). -->
    <!-- (merged into the first <type> block for this class above: one block per class, as
         Magento's di.xsd `uniqueType` constraint requires) -->

    <!--
      At order submit: re-resolve the account prices with a fresh TackQuote answer (20), then
      check every order limit against the total that will be charged (30).
    -->
    <!-- (merged into the first <type> block for this class above: one block per class, as
         Magento's di.xsd `uniqueType` constraint requires) -->

    <!--
      Buyer-group rules (Model\Groups\*): payment methods by group. The per-method decision is
      the payment_method_is_active observer (etc/<area>/events.xml); this plugin only keeps the
      rules from leaving a cart with no method at all.
    -->
    <type name="Magento\Payment\Model\MethodList">
        <plugin name="tackquote_group_payment_method_list"
                type="TackQuote\Quotes\Plugin\Payment\MethodListRestriction"
                sortOrder="10"/>
    </type>
    <!-- Buyer-group rules: shipping methods by group, and shipping discounts per group. -->
    <type name="Magento\Shipping\Model\Shipping">
        <plugin name="tackquote_group_shipping_rates"
                type="TackQuote\Quotes\Plugin\Shipping\GroupShippingRates"
                sortOrder="10"/>
    </type>
</config>
