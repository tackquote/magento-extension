<?xml version="1.0"?>
<!--
  Default values for TackQuote settings that need an explicit default.

  Each switch listed is OFF until a merchant turns it on: showing a customer's negotiated
  prices, or hiding the catalogue's prices behind "Price on request", is a decision a
  merchant makes, not something a module upgrade does to their storefront (the WooCommerce
  plugin ships the same switches defaulting to "no").
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <tackquote_quotes>
            <quote_only>
                <hide_prices>0</hide_prices>
            </quote_only>
            <b2b>
                <enable_account_price>0</enable_account_price>
                <enable_quantity_breaks>0</enable_quantity_breaks>
                <enable_order_limits>0</enable_order_limits>
                <enable_buyer_group_badge>0</enable_buyer_group_badge>
                <customer_groups></customer_groups>
            </b2b>
            <quote_request>
                <enable_quote_page>0</enable_quote_page>
                <enable_target_price>0</enable_target_price>
                <enable_cart_button>0</enable_cart_button>
                <enable_attachments>0</enable_attachments>
            </quote_request>
        </tackquote_quotes>
    </default>
</config>
