<?xml version="1.0"?>
<!--
  Default values for TackQuote settings that need an explicit default.

  Each switch listed is OFF until a merchant turns it on: showing a customer's negotiated
  prices, or hiding the catalogue's prices behind "Price on request", is a decision a
  merchant makes, not something a module upgrade does to their storefront (the WooCommerce
  plugin ships the same switches defaulting to "no").
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <tackquote_quotes>
            <quote_only>
                <hide_prices>0</hide_prices>
            </quote_only>
            <b2b>
                <enable_account_price>0</enable_account_price>
                <enable_quantity_breaks>0</enable_quantity_breaks>
                <enable_order_limits>0</enable_order_limits>
                <enable_buyer_group_badge>0</enable_buyer_group_badge>
                <customer_groups></customer_groups>
            </b2b>
            <b2b_checkout>
                <enforce_prices>0</enforce_prices>
                <enforce_order_limits>0</enforce_order_limits>
            </b2b_checkout>
            <quote_request>
                <enable_quote_page>0</enable_quote_page>
                <enable_target_price>0</enable_target_price>
                <enable_cart_button>0</enable_cart_button>
                <enable_attachments>0</enable_attachments>
            </quote_request>
            <!-- Wholesale account and Net terms tabs in My Account (lane MG-FORMS-TERMS). -->
            <forms>
                <enable_wholesale_tab>0</enable_wholesale_tab>
                <wholesale_form_slug></wholesale_form_slug>
                <enable_net_terms_tab>0</enable_net_terms_tab>
            </forms>
            <b2b_groups>
                <customer_groups></customer_groups>
                <enable_catalog_visibility>0</enable_catalog_visibility>
                <hide_catalog_when_unknown>0</hide_catalog_when_unknown>
                <enable_restrictions>0</enable_restrictions>
                <restrict_when_unknown>0</restrict_when_unknown>
                <enable_shipping_discounts>0</enable_shipping_discounts>
                <enable_tax_exempt>0</enable_tax_exempt>
                <tax_exempt_class>0</tax_exempt_class>
                <enable_group_mirror>0</enable_group_mirror>
            </b2b_groups>
        </tackquote_quotes>
        <!--
          "Pay on net terms" (lane MG-FORMS-TERMS). Off until the merchant turns it on.
          Offline, no payment_action: Magento places the order in state "new" with
          order_status "pending" (Magento\Sales\Model\Order\Payment::place()). Not offered
          in admin order creation (can_use_internal 0): there is no shopper's TackQuote
          standing to read there.
        -->
        <payment>
            <tackquote_net_terms>
                <model>TackQuote\Quotes\Model\Payment\NetTermsMethod</model>
                <active>0</active>
                <title>Pay on net terms</title>
                <description>Place this order on your approved payment terms. We will send an invoice.</description>
                <order_status>pending</order_status>
                <is_offline>1</is_offline>
                <can_use_checkout>1</can_use_checkout>
                <can_use_internal>0</can_use_internal>
                <po_number>0</po_number>
                <sort_order>100</sort_order>
                <group>offline</group>
            </tackquote_net_terms>
        </payment>
    </default>
</config>
